# Shell scripts and git hooks must stay LF on every platform — CRLF in
# the shebang line breaks bash on Linux/macOS, and the hook is invoked
# by Git for Windows' bundled bash which also handles LF correctly.
*.sh        text eol=lf
scripts/hooks/*  text eol=lf

# Claude Code rule files open with a YAML frontmatter block that decides
# when each one loads. Only the LF form of that block has been seen to
# work, so a Windows checkout must not turn it into CRLF.
.claude/rules/** text eol=lf
